# ── Copy this file to .env and fill in your real values ──────────────────────
# Never commit .env to version control.

# ── Telethon (personal account) ──────────────────────────────────────────────
# Get from https://my.telegram.org  → API development tools
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef
PHONE=+201012345678          # Your phone number in international format

# ── Control Bot ──────────────────────────────────────────────────────────────
# Create bot via @BotFather and paste the token here
BOT_TOKEN=7654321098:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your personal Telegram numeric user ID (get it from @userinfobot)
OWNER_ID=987654321

# ── Target chat ──────────────────────────────────────────────────────────────
# Username (e.g. @mygroup) OR numeric chat ID (e.g. -1001234567890)
TARGET_CHAT=@mygroup

# ── Reply text ───────────────────────────────────────────────────────────────
# Default reply message
DEFAULT_REPLY_TEXT=ماشاء الله 🎉

# ── Optional filters (leave blank to disable) ─────────────────────────────────
# Comma-separated numeric Telegram user IDs allowed to trigger the reply.
# Leave blank to allow ANY sender.
ALLOWED_SENDER_IDS=

# A word/phrase that must appear in the photo caption (case-insensitive).
# Leave blank to trigger on ANY photo regardless of caption.
CAPTION_KEYWORD=

# ── Target Groups ────────────────────────────────────────────────────────────
# Configure up to 10 groups. The bot will show inline buttons to choose.
# If no GROUP_*_NAME/ID are set, falls back to TARGET_CHAT above.
GROUP_1_NAME=مقراه أهل القرآن مبتدئات
GROUP_1_ID=-1001234567890

GROUP_2_NAME=مقراه أهل القرآن
GROUP_2_ID=-1001234567891

GROUP_3_NAME=الباقيات الصالحات
GROUP_3_ID=-1001234567892

GROUP_4_NAME=أهل القرآن سلمى سيد
GROUP_4_ID=-1001234567893